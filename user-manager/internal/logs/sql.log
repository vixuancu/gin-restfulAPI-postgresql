{"level":"info","trace_id":"e053ab43-9eba-45dd-a064-07666dc38dfc","duration":6.183146,"sql_orginal":"-- name: GetUserByEmail :one\nSELECT user_id, user_uuid, user_email, user_password, user_fullname, user_age, user_status, user_level, user_deleted_at, user_created_at, user_updated_at\nFROM users\nWHERE\n    user_email = $1\n    AND user_deleted_at IS NULL\n","sql":"SELECT user_id, user_uuid, user_email, user_password, user_fullname, user_age, user_status, user_level, user_deleted_at, user_created_at, user_updated_at FROM users WHERE user_email = 'xuancu15@gmail.com' AND user_deleted_at IS NULL","query_name":"GetUserByEmail","operation":"ONE","args":["xuancu15@gmail.com"],"event":"Query","time":"2025-08-19T08:27:20Z","message":"Executed Sql"}
{"level":"info","trace_id":"9d975be7-bb52-44f4-9cc6-7c6199b7db23","duration":5.419765,"sql_orginal":"-- name: CountUsers :one\nSELECT COUNT(*)\nFROM users\nWHERE (\n    $1::bool IS NULL\n    OR ($1::bool = TRUE AND user_deleted_at IS NOT NULL)\n    OR ($1::bool = FALSE AND user_deleted_at IS NULL)\n) AND (\n    $2::TEXT IS NULL\n    OR $2::TEXT = ''\n    OR user_email ILIKE '%' || $2 || '%'\n    OR user_fullname ILIKE '%' || $2 || '%'\n)\n","sql":"SELECT COUNT(*) FROM users WHERE ( false::bool IS NULL OR (false::bool = TRUE AND user_deleted_at IS NOT NULL) OR (false::bool = FALSE AND user_deleted_at IS NULL) ) AND ( 'xuancu'::TEXT IS NULL OR 'xuancu'::TEXT = '' OR user_email ILIKE '%' || 'xuancu' || '%' OR user_fullname ILIKE '%' || 'xuancu' || '%' )","query_name":"CountUsers","operation":"ONE","args":[false,"xuancu"],"event":"Query","time":"2025-08-19T08:27:39Z","message":"Executed Sql"}
{"level":"info","trace_id":"9d975be7-bb52-44f4-9cc6-7c6199b7db23","duration":4.130709,"sql_orginal":"SELECT *\n\tFROM users\n\tWHERE (\n\t\t$1::TEXT IS NULL\n\t\tOR $1::TEXT = ''\n\t\tOR user_email ILIKE '%' || $1 || '%'\n\t\tOR user_fullname ILIKE '%' || $1 || '%'\n\t) AND user_deleted_at IS NULL ORDER BY user_created_at DESC LIMIT $2 OFFSET $3","sql":"SELECT * FROM users WHERE ( 'xuancu'::TEXT IS NULL OR 'xuancu'::TEXT = '' OR user_email ILIKE '%' || 'xuancu' || '%' OR user_fullname ILIKE '%' || 'xuancu' || '%' ) AND user_deleted_at IS NULL ORDER BY user_created_at DESC LIMIT 10 OFFSET 0","query_name":"","operation":"","args":["xuancu",10,0],"event":"Query","time":"2025-08-19T08:27:39Z","message":"Executed Sql"}
