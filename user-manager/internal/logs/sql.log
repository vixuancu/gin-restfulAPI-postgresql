{"level":"info","trace_id":"42ff5e6c-2dfd-482c-acbd-374fcf63175d","duration":5.79231,"sql_orginal":"-- name: ListUsersCreateAtAsc :many\nSELECT user_id, user_uuid, user_email, user_password, user_fullname, user_age, user_status, user_level, user_deleted_at, user_created_at, user_updated_at\nFROM users\nWHERE user_deleted_at IS NULL\nAND (\n    $3::TEXT IS NULL\n    OR $3::TEXT = ''\n    OR user_email ILIKE '%' || $3 || '%'\n    OR user_fullname ILIKE '%' || $3 || '%'\n)\nORDER BY user_deleted_at ASC\nLIMIT $1 OFFSET $2\n","sql":"SELECT user_id, user_uuid, user_email, user_password, user_fullname, user_age, user_status, user_level, user_deleted_at, user_created_at, user_updated_at FROM users WHERE user_deleted_at IS NULL AND ( ''::TEXT IS NULL OR ''::TEXT = '' OR user_email ILIKE '%' || '' || '%' OR user_fullname ILIKE '%' || '' || '%' ) ORDER BY user_deleted_at ASC LIMIT 10 OFFSET 0","query_name":"ListUsersCreateAtAsc","operation":"MANY","args":[10,0,""],"event":"Query","time":"2025-08-16T10:01:05+07:00","message":"Executed Sql"}
