{"level":"info","trace_id":"6f0ed604-31c4-41a1-92a8-dfbf7f28c91e","duration":20.027223,"sql_orginal":"-- name: CountUsers :one\nSELECT COUNT(*)\nFROM users\nWHERE (\n    $1::bool IS NULL\n    OR ($1::bool = TRUE AND user_deleted_at IS NOT NULL)\n    OR ($1::bool = FALSE AND user_deleted_at IS NULL)\n) AND (\n    $2::TEXT IS NULL\n    OR $2::TEXT = ''\n    OR user_email ILIKE '%' || $2 || '%'\n    OR user_fullname ILIKE '%' || $2 || '%'\n)\n","sql":"SELECT COUNT(*) FROM users WHERE ( false::bool IS NULL OR (false::bool = TRUE AND user_deleted_at IS NOT NULL) OR (false::bool = FALSE AND user_deleted_at IS NULL) ) AND ( 'xuancu'::TEXT IS NULL OR 'xuancu'::TEXT = '' OR user_email ILIKE '%' || 'xuancu' || '%' OR user_fullname ILIKE '%' || 'xuancu' || '%' )","query_name":"CountUsers","operation":"ONE","args":[false,"xuancu"],"event":"Query","time":"2025-08-18T15:45:47+07:00","message":"Executed Sql"}
{"level":"info","trace_id":"6f0ed604-31c4-41a1-92a8-dfbf7f28c91e","duration":6.319141,"sql_orginal":"SELECT *\n\tFROM users\n\tWHERE (\n\t\t$1::TEXT IS NULL\n\t\tOR $1::TEXT = ''\n\t\tOR user_email ILIKE '%' || $1 || '%'\n\t\tOR user_fullname ILIKE '%' || $1 || '%'\n\t) AND user_deleted_at IS NULL ORDER BY user_created_at DESC LIMIT $2 OFFSET $3","sql":"SELECT * FROM users WHERE ( 'xuancu'::TEXT IS NULL OR 'xuancu'::TEXT = '' OR user_email ILIKE '%' || 'xuancu' || '%' OR user_fullname ILIKE '%' || 'xuancu' || '%' ) AND user_deleted_at IS NULL ORDER BY user_created_at DESC LIMIT 10 OFFSET 0","query_name":"","operation":"","args":["xuancu",10,0],"event":"Query","time":"2025-08-18T15:45:47+07:00","message":"Executed Sql"}
